@startuml
title ECS Engine Prototype - Runtime Loop

skinparam shadowing false
skinparam linetype ortho

start

:Create Application;
:Initialize Window and OpenGL context;
:Load GLAD;
:Create World;
:Register Systems;
:Create Boids scenario;

while (Application running?) is (yes)
  :Poll window/input events;
  :Compute delta time;
  :Begin frame profiling;

  partition "Simulation Update" {
    :Update Boid System;
    :Update Movement System;
  }

  partition "Rendering" {
    :Build instance data;
    :Render agents with camera;
    :Present frame;
  }

  partition "Benchmark" {
    :Record frame time;
    :Record simulation time;
    :Record rendering time;
  }
endwhile (no)

:Export or summarize metrics;
:Shutdown runtime;

stop

@enduml
