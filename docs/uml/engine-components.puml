@startuml
title ECS Engine Prototype - Component Architecture

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

package "Sandbox" {
  [Boids Demo] as BoidsDemo
  [Benchmark Scenarios] as BenchmarkScenarios
  [OOP Comparison] as OopComparison
}

package "Engine" as EnginePkg {
  package "Core" {
    [Application] as Application
    [Game Loop] as GameLoop
    [Time Step] as TimeStep
  }

  package "Platform" {
    [Window] as Window
    [Input] as Input
  }

  package "Scene" {
    [World / Scene] as World
  }

  package "ECS" {
    [Registry] as Registry
    [Entity Manager] as EntityManager
    [Component Storage] as ComponentStorage
    [System Manager] as SystemManager
  }

  package "Simulation" as SimulationPkg {
    [Boid System] as BoidSystem
    [Movement System] as MovementSystem
    [3D Spatial Grid] as SpatialGrid
  }

  package "Renderer" {
    [Render System] as RenderSystem
    [Camera] as Camera
    [Instanced Agent Renderer] as InstancedRenderer
  }

  package "Benchmark" {
    [Frame Profiler] as FrameProfiler
    [Metrics Collector] as MetricsCollector
  }
}

package "Third Party" {
  [GLFW] as GLFW
  [GLAD] as GLAD
  [OpenGL 3.3 Core] as OpenGL
}

BoidsDemo --> Application
BoidsDemo --> World
BoidsDemo --> Registry
BoidsDemo --> RenderSystem

BenchmarkScenarios --> FrameProfiler
BenchmarkScenarios --> MetricsCollector
BenchmarkScenarios --> BoidSystem

OopComparison ..> BenchmarkScenarios : comparison baseline

Application --> GameLoop
Application --> Window
Application --> Input
Application --> TimeStep
Application --> World

GameLoop --> SystemManager : update systems
GameLoop --> RenderSystem : render frame
GameLoop --> FrameProfiler : measure frame

Window --> GLFW
Input --> GLFW
GLFW --> OpenGL : creates context
GLAD --> OpenGL : loads functions

World --> Registry
World --> SystemManager

Registry --> EntityManager
Registry --> ComponentStorage
SystemManager --> BoidSystem
SystemManager --> MovementSystem
SystemManager --> RenderSystem

BoidSystem --> Registry : reads/writes components
BoidSystem --> SpatialGrid : neighbor query
MovementSystem --> Registry : updates transforms

RenderSystem --> Registry : reads render data
RenderSystem --> Camera
RenderSystem --> InstancedRenderer
InstancedRenderer --> GLAD
InstancedRenderer --> OpenGL

FrameProfiler --> MetricsCollector
MetricsCollector --> BenchmarkScenarios

note right of EnginePkg
  Lightweight game engine runtime.
  Not a general-purpose editor or asset pipeline.
end note

note bottom of SimulationPkg
  Research target:
  3D Boids simulation,
  ECS vs OOP comparison,
  3D Grid optimization.
end note

@enduml
