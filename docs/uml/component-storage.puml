@startuml
title ECS Engine Prototype - Component Storage

left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam linetype ortho

rectangle "Entity IDs" as EntityIds {
  rectangle "Entity 0"
  rectangle "Entity 1"
  rectangle "Entity 2"
  rectangle "Entity N"
}

package "Typed Component Storage" {
  rectangle "Transform Membership\nentity -> dense index" as TransformMembership
  rectangle "Velocity Membership\nentity -> dense index" as VelocityMembership
  rectangle "Boid Membership\nentity -> dense index" as BoidMembership
  rectangle "Renderable Membership\nentity -> dense index" as RenderableMembership
  database "Transform Storage\nDense array" as TransformStorage
  database "Velocity Storage\nDense array" as VelocityStorage
  database "Boid Storage\nDense array" as BoidStorage
  database "Renderable Storage\nDense array" as RenderableStorage
}

package "Public Query API" {
  [Registry::view<T...>()] as RegistryView
  [View<Transform, Velocity, Boid>\n.each(...)] as BoidView
  [View<Transform, Velocity>\n.each(...)] as MovementView
  [View<Transform, Renderable>\n.each(...)] as RenderView
}

package "Systems" {
  [Boid System] as BoidSystem
  [Movement System] as MovementSystem
  [Render System] as RenderSystem
}

EntityIds --> TransformMembership : optional component
EntityIds --> VelocityMembership : optional component
EntityIds --> BoidMembership : optional component
EntityIds --> RenderableMembership : optional component

TransformMembership --> TransformStorage : dense index
VelocityMembership --> VelocityStorage : dense index
BoidMembership --> BoidStorage : dense index
RenderableMembership --> RenderableStorage : dense index

BoidSystem --> RegistryView : requests typed view
MovementSystem --> RegistryView : requests typed view
RenderSystem --> RegistryView : requests typed view

RegistryView --> BoidView
RegistryView --> MovementView
RegistryView --> RenderView

BoidView --> TransformMembership : membership check
BoidView --> VelocityMembership : membership check
BoidView --> BoidMembership : membership check
BoidView --> TransformStorage : component access
BoidView --> VelocityStorage : component access
BoidView --> BoidStorage : component access

MovementView --> TransformMembership : membership check
MovementView --> VelocityMembership : membership check
MovementView --> TransformStorage : component access
MovementView --> VelocityStorage : component access

RenderView --> TransformMembership : membership check
RenderView --> RenderableMembership : membership check
RenderView --> TransformStorage : component access
RenderView --> RenderableStorage : component access

note bottom
  Sparse-set storage is an internal implementation detail.
  Systems iterate through typed views, so the public API can
  remain stable if storage later changes to archetype chunks.
end note

@enduml
