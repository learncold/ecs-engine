@startuml Runtime_Initialization_Sequence

title Runtime Initialization Sequence

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceArrowThickness 1
skinparam ParticipantBorderColor #44546A
skinparam ParticipantBackgroundColor #F7F9FC
skinparam ArrowColor #59636E
skinparam LifeLineBorderColor #7A8795
skinparam LifeLineBackgroundColor #FFFFFF

autonumber

actor User
participant "main()" as Main
participant "Application" as Application
participant "GLFW / OpenGL" as GraphicsApi
participant "Input" as Input
participant "DebugUi" as DebugUi
participant "BoidSimulation" as Simulation
participant "Registry" as Registry
participant "Transform functions" as TransformFunctions
participant "AgentRenderManager" as RenderManager
participant "EcsRenderSystem" as EcsRenderSystem
participant "AgentRenderer" as AgentRenderer
participant "LineRenderer" as LineRenderer
participant "PerformancePanel" as PerformancePanel

User -> Main : Start App.exe
activate Main

create Application
Main -> Application : construct
create Simulation
Main -> Simulation : construct(config)
Simulation -> Simulation : validate config
Simulation -> Simulation : register four systems in order
create RenderManager
Main -> RenderManager : construct(boundary_half_extent)
RenderManager -> RenderManager : build Grid and boundary lines
create EcsRenderSystem
Main -> EcsRenderSystem : default construct
create PerformancePanel
Main -> PerformancePanel : default construct

Main -> Application : Initialize()
activate Application
Application -> GraphicsApi : initialize GLFW
Application -> GraphicsApi : create window and OpenGL context
Application -> GraphicsApi : load OpenGL functions with GLAD
Application -> Input : Initialize(window)
Application -> DebugUi : Initialize(window)
Application --> Main : true
deactivate Application

Main -> Simulation : Initialize()
activate Simulation
Simulation -> Registry : Clear()
loop boid_count times
  Simulation -> Registry : Create()
  Registry --> Simulation : Entity
  Simulation -> TransformFunctions : RotationFromDirection(initial_velocity)
  TransformFunctions --> Simulation : initial quaternion
  Simulation -> Registry : Emplace Transform and MeshRenderer
  Simulation -> Registry : Emplace Velocity, Acceleration and BoidParameters
end
Simulation --> Main : initialized Registry
deactivate Simulation

Main -> RenderManager : Initialize()
activate RenderManager
RenderManager -> AgentRenderer : Initialize()
AgentRenderer --> RenderManager : success
RenderManager -> LineRenderer : Initialize(environment_lines)
LineRenderer --> RenderManager : success
RenderManager --> Main : true
deactivate RenderManager

Main -> Application : Run(update, render, ui callbacks)
note right of Application
  Control remains in Application::Run
  until the window closes.
end note
Application --> Main : returns after window closes

deactivate Main

@enduml

@startuml Runtime_Frame_Sequence

title One Runtime Frame Sequence

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceArrowThickness 1
skinparam ParticipantBorderColor #44546A
skinparam ParticipantBackgroundColor #F7F9FC
skinparam ArrowColor #59636E
skinparam LifeLineBorderColor #7A8795
skinparam LifeLineBackgroundColor #FFFFFF

autonumber

participant "Application" as Application
participant "DebugUi" as DebugUi
participant "Input" as Input
participant "Update callback" as UpdateCallback
participant "BoidSimulation" as Simulation
participant "SystemManager" as SystemManager
participant "Boid systems" as BoidSystems
participant "Registry" as Registry
participant "AgentRenderManager" as RenderManager
participant "OrbitCameraController" as CameraController
participant "Render callback" as RenderCallback
participant "EcsRenderSystem" as EcsRenderSystem
participant "Transform functions" as TransformFunctions
participant "LineRenderer" as LineRenderer
participant "AgentRenderer" as AgentRenderer
participant "UI callback" as UiCallback
participant "PerformancePanel" as PerformancePanel
participant "GLFW / OpenGL" as GraphicsApi

loop while window is open
  Application -> Application : calculate delta_seconds
  Application -> DebugUi : BeginFrame()
  Application -> DebugUi : WantsCaptureKeyboard/Mouse()
  DebugUi --> Application : capture flags
  Application -> Input : Update(enabled flags)
  Input --> Application : update complete
  Application -> Input : State()
  Input --> Application : const InputState&

  group Simulation and camera update
    Application -> UpdateCallback : invoke(delta_seconds, InputState)
    UpdateCallback -> Simulation : Update(delta_seconds)
    Simulation -> SystemManager : Update(Registry, delta_seconds)

    SystemManager -> BoidSystems : 1. BoidSystem::Update()
    BoidSystems -> Registry : View<Transform, Velocity, BoidParameters, Acceleration>
    Registry --> BoidSystems : matching components
    BoidSystems -> Registry : write Acceleration
    BoidSystems --> SystemManager : complete

    SystemManager -> BoidSystems : 2. MovementSystem::Update()
    BoidSystems -> Registry : update Velocity and Transform.position
    BoidSystems --> SystemManager : complete

    SystemManager -> BoidSystems : 3. BoundarySystem::Update()
    BoidSystems -> Registry : clamp position and reflect Velocity
    BoidSystems --> SystemManager : complete

    SystemManager -> BoidSystems : 4. BoidOrientationSystem::Update()
    BoidSystems -> Registry : write Transform.rotation from final Velocity
    BoidSystems --> SystemManager : complete
    SystemManager --> Simulation : systems complete
    Simulation --> UpdateCallback : update complete

    UpdateCallback -> RenderManager : UpdateCamera(InputState, delta_seconds)
    RenderManager -> CameraController : Update(Camera, InputState, delta_seconds)
    CameraController --> RenderManager : camera updated
    UpdateCallback --> Application : callback complete
  end

  Application -> GraphicsApi : get framebuffer size and clear buffers

  group ECS render extraction and common rendering
    Application -> RenderCallback : invoke(width, height)
    RenderCallback -> Simulation : GetRegistry()
    Simulation --> RenderCallback : Registry&
    RenderCallback -> EcsRenderSystem : Render(Registry, RenderManager, width, height)
    EcsRenderSystem -> EcsRenderSystem : clear and reserve instance buffer
    EcsRenderSystem -> Registry : View<Transform, MeshRenderer>()
    Registry --> EcsRenderSystem : renderable components
    loop each renderable entity
      EcsRenderSystem -> EcsRenderSystem : append RenderInstance
    end

    EcsRenderSystem -> RenderManager : Render(instances, width, height)
    loop each Agent RenderInstance
      RenderManager -> TransformFunctions : ToModelMatrix(Transform)
      TransformFunctions --> RenderManager : model matrix
    end
    RenderManager -> RenderManager : calculate view-projection matrix
    RenderManager -> LineRenderer : Render(view_projection)
    LineRenderer -> GraphicsApi : draw Grid and boundary lines
    RenderManager -> AgentRenderer : Render(model_matrices, view_projection, camera_position)
    AgentRenderer -> GraphicsApi : upload instance buffer
    AgentRenderer -> GraphicsApi : glDrawArraysInstanced()
    RenderManager --> EcsRenderSystem : render complete
    EcsRenderSystem --> RenderCallback : complete
    RenderCallback --> Application : callback complete
  end

  group Debug UI and presentation
    Application -> UiCallback : invoke()
    UiCallback -> Application : IsVSyncEnabled()
    Application --> UiCallback : current VSync state
    UiCallback -> PerformancePanel : Draw(boid_count, vsync_enabled)
    PerformancePanel --> UiCallback : whether VSync changed
    alt VSync changed
      UiCallback -> Application : SetVSyncEnabled(new state)
      Application -> GraphicsApi : glfwSwapInterval(0 or 1)
    end
    UiCallback --> Application : callback complete
    Application -> DebugUi : Render()
    DebugUi -> GraphicsApi : render ImGui draw data
    Application -> GraphicsApi : swap buffers
    Application -> GraphicsApi : poll events
  end
end

note over EcsRenderSystem,AgentRenderer
  EcsRenderSystem knows the Registry.
  AgentRenderManager and AgentRenderer receive only common render data.
end note

@enduml
