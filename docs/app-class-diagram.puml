@startuml App_Class_Diagram

title App Class and Composition Diagram

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam ArrowColor #59636E
skinparam ClassBorderColor #44546A
skinparam ClassBackgroundColor #F5FBF4
skinparam PackageBorderColor #5E8759
skinparam PackageBackgroundColor #EAF6E8

hide empty members

package "Engine dependencies" #EEF3F8 {
  class "engine::core::Application" as Application {
    + Initialize() : bool
    + Run(update, render, ui) : void
    + SetVSyncEnabled(enabled : bool) : void
    + IsVSyncEnabled() : bool
  }

  class "engine::input::InputState" as InputState <<data>>

  class "engine::renderer::AgentRenderManager" as AgentRenderManager {
    + AgentRenderManager(boundary_half_extent : float)
    + Initialize() : bool
    + UpdateCamera(input, delta_seconds) : void
    + Render(instances, width, height) : void
  }

  class "engine::ecs_renderer::EcsRenderSystem" as EcsRenderSystem {
    + Extract(registry) : void
    + Render(registry, renderer, width, height) : void
  }

  class "engine::ecs::Registry" as Registry
}

package "Boids dependency" #FFF3DF {
  class "boids::BoidSimulationConfig" as BoidSimulationConfig <<data>> {
    + boid_count : size_t
    + boundary_half_extent : float
  }

  class "boids::ecs::BoidSimulation" as BoidSimulation {
    + BoidSimulation(config : BoidSimulationConfig)
    + Initialize() : void
    + Update(delta_seconds : float) : void
    + GetRegistry() : Registry&
  }
}

package "app" {
  class "main()" as AppCompositionRoot <<composition root>> {
    + main() : int
  }

  class "update callback" as UpdateCallback <<lambda>> {
    + operator()(delta_seconds, input) : void
  }

  class "render callback" as RenderCallback <<lambda>> {
    + operator()(framebuffer_width, framebuffer_height) : void
  }

  class "UI callback" as UiCallback <<lambda>> {
    + operator()() : void
  }
}

package "app::ui" {
  class "app::ui::PerformancePanel" as PerformancePanel {
    + Draw(boid_count : size_t, vsync_enabled : bool&) : bool
  }
}

' Objects created as local values for the application's lifetime.
AppCompositionRoot *-- Application : creates
AppCompositionRoot *-- BoidSimulationConfig : creates
AppCompositionRoot *-- BoidSimulation : creates
AppCompositionRoot *-- AgentRenderManager : creates
AppCompositionRoot *-- EcsRenderSystem : creates
AppCompositionRoot *-- PerformancePanel : creates

' Callback composition and dispatch.
AppCompositionRoot *-- UpdateCallback : defines
AppCompositionRoot *-- RenderCallback : defines
AppCompositionRoot *-- UiCallback : defines
AppCompositionRoot --> Application : initializes and runs
Application ..> UpdateCallback : invokes every frame
Application ..> RenderCallback : invokes every frame
Application ..> UiCallback : invokes every frame

' Update callback wiring.
UpdateCallback ..> InputState : receives
UpdateCallback --> BoidSimulation : Update()
UpdateCallback --> AgentRenderManager : UpdateCamera()

' Render callback wiring.
RenderCallback --> BoidSimulation : GetRegistry()
BoidSimulation --> Registry : exposes
RenderCallback --> EcsRenderSystem : Render()
RenderCallback ..> AgentRenderManager : passes manager
RenderCallback ..> Registry : passes registry

' UI callback wiring.
UiCallback --> Application : reads and changes VSync
UiCallback --> PerformancePanel : Draw()
UiCallback ..> BoidSimulationConfig : captures boid_count

' Construction parameters.
BoidSimulation ..> BoidSimulationConfig : constructed from
AppCompositionRoot ..> BoidSimulationConfig : reads boundary_half_extent

note right of AppCompositionRoot
  main() is not a C++ class.
  It is represented as a composition-root node because it creates
  the process-lifetime objects and connects their callbacks.
end note

note bottom of RenderCallback
  App passes Registry and AgentRenderManager to EcsRenderSystem.
  It does not query ECS Views or build model matrices itself.
end note

note bottom of AppCompositionRoot
  App contains no Boids system implementation and no OpenGL calls.
  Domain behavior stays in Boids; rendering stays in Engine.
end note

@enduml
